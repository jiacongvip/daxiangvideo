{"type": "SentenceBoundary", "offset": 1000000, "duration": 83064811, "text": "\u514d\u8d39\u7ba1\u7406\u652f\u6301\u6309\u4f1a\u5458\u7b49\u7ea7\u914d\u7f6e\u514d\u8d39\u6761\u4ef6\uff0c\u5e76\u8bbe\u7f6e\u6bcf\u65e5\u514d\u8d39\u6b21\u6570\uff0c\u7cfb\u7edf\u7edf\u8ba1\u548c\u68c0\u67e5\u6b21\u6570\u3002"}
{"type": "SentenceBoundary", "offset": 83564811, "duration": 118981476, "text": "\u514d\u8d39\u8d44\u683c\u4e0e\u751f\u6210\u4efb\u52a1\u72b6\u6001\u4e0d\u540c\uff0c\u8fd0\u8425\u5148\u6838\u5bf9\u4f1a\u5458\u6761\u4ef6\uff0c\u518d\u6838\u5bf9\u4f7f\u7528\u6b21\u6570\uff1b\u4e0d\u628a\u6709\u514d\u8d39\u5165\u53e3\u7406\u89e3\u4e3a\u6240\u6709\u7528\u6237\u90fd\u53ef\u4ee5\u65e0\u9650\u6b21\u8c03\u7528\u5916\u90e8AI\u670d\u52a1\u3002"}
