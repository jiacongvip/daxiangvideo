{"type": "SentenceBoundary", "offset": 1000000, "duration": 79324070, "text": "\u65b9\u6848\u8bbe\u8ba1\u597d\u540e\uff0c\u5728\u8be5\u65b9\u6848\u884c\u70b9\u51fb\u5e94\u7528\u5546\u54c1\uff0c\u641c\u7d22\u9700\u8981\u4f7f\u7528\u5b83\u7684\u5546\u54c1\uff0c\u52fe\u9009\u540e\u5e94\u7528\u5230\u6240\u9009\u5546\u54c1\u3002"}
{"type": "SentenceBoundary", "offset": 80324070, "duration": 96874996, "text": "\u540c\u4e00\u4e2a\u65b9\u6848\u53ef\u7528\u4e8e\u9009\u4e2d\u7684\u591a\u4e2a\u5546\u54c1\uff0c\u64cd\u4f5c\u524d\u6838\u5bf9\u6240\u9009\u8303\u56f4\uff0c\u907f\u514d\u628a\u4e00\u6b21\u6279\u91cf\u5e94\u7528\u7406\u89e3\u4e3a\u5168\u5546\u57ce\u5546\u54c1\u90fd\u66f4\u6362\u4e86\u65b9\u6848\u3002"}
