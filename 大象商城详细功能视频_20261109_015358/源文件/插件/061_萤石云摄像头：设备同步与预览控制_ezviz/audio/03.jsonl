{"type": "SentenceBoundary", "offset": 1000000, "duration": 55749997, "text": "\u8bbe\u5907\u7ba1\u7406\u652f\u6301\u8fdc\u7a0b\u6293\u56fe\uff0c\u4ee5\u53ca\u4e91\u53f0\u516b\u65b9\u5411\u7684\u542f\u52a8\u548c\u505c\u6b62\u63a7\u5236\u3002"}
{"type": "SentenceBoundary", "offset": 56249997, "duration": 126620365, "text": "\u9884\u89c8\u7528\u4e8e\u770b\u753b\u9762\uff0c\u6293\u56fe\u7528\u4e8e\u83b7\u53d6\u5f53\u65f6\u56fe\u50cf\uff0c\u4e91\u53f0\u63a7\u5236\u6539\u53d8\u8bbe\u5907\u65b9\u5411\uff1b\u5b9e\u9645\u64cd\u4f5c\u8fd8\u8981\u5bf9\u5e94\u8bbe\u5907\u81ea\u8eab\u7684\u80fd\u529b\u4e0e\u53ef\u7528\u72b6\u6001\uff0c\u4e0d\u628a\u4e09\u4e2a\u64cd\u4f5c\u6df7\u4e3a\u5f55\u50cf\u56de\u653e\u3002"}
