{"type": "SentenceBoundary", "offset": 1000000, "duration": 155249993, "text": "\u989d\u5ea6\u660e\u7ec6\u5c55\u793a\u65f6\u95f4\u3001\u6d3b\u52a8\u3001\u6765\u6e90\u3001\u4f7f\u7528\u6216\u8c03\u6574\u6570\u91cf\u3001\u53d8\u5316\u524d\u540e\u6709\u6548\u989d\u5ea6\u548c\u5df2\u7528\u91cf\u3001\u5269\u4f59\u989d\u5ea6\u3001\u8ba1\u5212\u53f7\u3001\u64cd\u4f5c\u4eba\u53ca\u5907\u6ce8\uff0c\u53ef\u6309\u65e5\u671f\u3001\u6d3b\u52a8\u548c\u53d8\u52a8\u7c7b\u578b\u7b5b\u9009\uff0c\u4e0d\u80fd\u76f4\u63a5\u5220\u9664\u3002"}
{"type": "SentenceBoundary", "offset": 156249993, "duration": 74999997, "text": "\u8f6c\u5316\u3001\u53d1\u653e\u548c\u5956\u52b1\u8fd8\u6709\u5404\u81ea\u4efb\u52a1\u4e0e\u65e5\u5fd7\uff0c\u4e0d\u80fd\u53ea\u770b\u5956\u52b1\u65e5\u5fd7\u5c31\u8ba4\u5b9a\u5168\u90e8\u5206\u671f\u5df2\u5c65\u884c\u3002"}
