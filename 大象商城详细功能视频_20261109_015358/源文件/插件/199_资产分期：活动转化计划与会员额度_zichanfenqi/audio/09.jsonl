{"type": "SentenceBoundary", "offset": 1000000, "duration": 127935180, "text": "\u8fd9\u6b21\u6f14\u793a\u5148\u914d\u7f6e\u6765\u6e90\u4e0e\u6d3b\u52a8\uff0c\u518d\u6309\u4f59\u989d\u3001\u5355\u6b21\u9650\u5236\u548c\u5171\u4eab\u989d\u5ea6\u8f6c\u5316\uff0c\u533a\u5206\u5206\u671f\u8ba1\u5212\u4e0e\u9010\u671f\u53d1\u653e\uff0c\u6700\u540e\u7ba1\u7406\u5206\u7ec4\u3001\u4e2a\u4eba\u548c\u65e5\u671f\u989d\u5ea6\u5e76\u56de\u67e5\u65e5\u5fd7\u3002"}
{"type": "SentenceBoundary", "offset": 128935180, "duration": 85300922, "text": "\u5927\u8c61\u5546\u57ce\u8d44\u4ea7\u5206\u671f\uff0c\u628a\u8d26\u6237\u8f6c\u5316\u3001\u989d\u5ea6\u7ba1\u7406\u548c\u8ba1\u5212\u6267\u884c\u5206\u5c42\u7ec4\u7ec7\uff0c\u4fbf\u4e8e\u5e73\u53f0\u6309\u5bf9\u5e94\u8bb0\u5f55\u6838\u5bf9\u3002"}
