{"type": "SentenceBoundary", "offset": 1000000, "duration": 106638884, "text": "\u5c0f\u7a0b\u5e8f\u4e2d\u5fc3\u8fd8\u63a5\u5165\u597d\u7269\u5708\u7684\u7269\u54c1\u3001\u8ba2\u5355\u4e0e\u6536\u85cf\u80fd\u529b\uff0c\u4ee5\u53ca\u4ea4\u6613\u7ec4\u4ef6\u3001\u5c0f\u5546\u5e97\u3001\u8054\u76df\u63a8\u5ba2\u3001\u5fae\u4fe1\u4eba\u5de5\u667a\u80fd\u548c\u7533\u8bc9\u4ee3\u63d0\u4ea4\u3002"}
{"type": "SentenceBoundary", "offset": 107638884, "duration": 96296292, "text": "\u8fd9\u91cc\u7ba1\u7406\u7684\u662f\u5bf9\u5e94\u5e73\u53f0\u80fd\u529b\u7684\u5165\u53e3\u4e0e\u8c03\u7528\uff0c\u6d89\u53ca\u4e92\u65a5\u7684\u80fd\u529b\u6309\u5b9e\u9645\u6388\u6743\u9009\u62e9\uff0c\u4e0d\u628a\u4ee3\u63d0\u4ea4\u7533\u8bc9\u5f53\u6210\u7533\u8bc9\u4e00\u5b9a\u6210\u529f\u3002"}
