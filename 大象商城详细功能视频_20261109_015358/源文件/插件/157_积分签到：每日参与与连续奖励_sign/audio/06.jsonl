{"type": "SentenceBoundary", "offset": 1000000, "duration": 106407403, "text": "\u8fd9\u6b21\u6f14\u793a\u4ece\u5f00\u5173\u548c\u6bcf\u65e5\u79ef\u5206\u5f00\u59cb\uff0c\u4e32\u8d77\u4f1a\u5458\u6bcf\u5929\u4e00\u6b21\u7b7e\u5230\u3001\u8fde\u7eed\u6761\u4ef6\u68c0\u67e5\u3001\u79ef\u5206\u4e0e\u4f18\u60e0\u5238\u5956\u52b1\uff0c\u518d\u56de\u5230\u6b21\u6570\u548c\u79ef\u5206\u8bb0\u5f55\u3002"}
{"type": "SentenceBoundary", "offset": 107407403, "duration": 101967588, "text": "\u5927\u8c61\u5546\u57ce\u79ef\u5206\u7b7e\u5230\uff0c\u628a\u57fa\u7840\u53c2\u4e0e\u3001\u8fde\u7eed\u6fc0\u52b1\u548c\u8bb0\u5f55\u67e5\u8be2\u5206\u5f00\u7ba1\u7406\uff0c\u4fbf\u4e8e\u8fd0\u8425\u8bf4\u660e\u89c4\u5219\uff0c\u4f1a\u5458\u67e5\u770b\u81ea\u5df1\u7684\u53c2\u4e0e\u60c5\u51b5\u3002"}
