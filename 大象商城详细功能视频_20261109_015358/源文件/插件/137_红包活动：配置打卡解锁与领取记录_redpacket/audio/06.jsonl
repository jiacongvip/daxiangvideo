{"type": "SentenceBoundary", "offset": 1000000, "duration": 60379627, "text": "\u540e\u53f0\u7edf\u8ba1\u63d0\u4f9b\u53c2\u4e0e\u7528\u6237\u6570\u3001\u5df2\u53d1\u653e\u91d1\u989d\u3001\u89e3\u9501\u7387\u548c\u9886\u53d6\u5b8c\u6210\u7387\u3002"}
{"type": "SentenceBoundary", "offset": 60879627, "duration": 94444440, "text": "\u7528\u6237\u8bb0\u5f55\u53ef\u4ee5\u67e5\u770b\u53c2\u4e0e\u60c5\u51b5\u3001\u7b5b\u9009\u6d3b\u52a8\u72b6\u6001\u5e76\u5bfc\u51fa\u6570\u636e\uff1b\u9886\u53d6\u65e5\u5fd7\u8fd8\u53ef\u4ee5\u6309\u6d3b\u52a8\u7b5b\u9009\uff0c\u67e5\u770b\u53d1\u653e\u660e\u7ec6\u3002"}
{"type": "SentenceBoundary", "offset": 155324067, "duration": 88541663, "text": "\u7edf\u8ba1\u56de\u7b54\u6574\u4f53\u60c5\u51b5\uff0c\u65e5\u5fd7\u56de\u7b54\u5177\u4f53\u8bb0\u5f55\uff0c\u8fd0\u8425\u6309\u6d3b\u52a8\u6838\u5bf9\u7528\u6237\u8bb0\u5f55\uff0c\u8fdb\u4e00\u6b65\u67e5\u770b\u5bf9\u5e94\u9886\u53d6\u4e0e\u53d1\u653e\u660e\u7ec6\u3002"}
