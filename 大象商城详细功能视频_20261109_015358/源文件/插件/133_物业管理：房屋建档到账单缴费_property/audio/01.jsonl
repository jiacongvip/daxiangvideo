{"type": "SentenceBoundary", "offset": 1000000, "duration": 108837958, "text": "\u5c0f\u533a\u7ba1\u7406\u7ef4\u62a4\u540d\u79f0\u3001\u5730\u5740\u548c\u63cf\u8ff0\uff0c\u8bbe\u7f6e\u6309\u9762\u79ef\u8ba1\u7b97\u7684\u7269\u4e1a\u8d39\u5355\u4ef7\uff0c\u4ee5\u53ca\u6309\u6708\u3001\u5b63\u5ea6\u6216\u5e74\u7684\u7f34\u8d39\u5468\u671f\uff0c\u8fd8\u80fd\u63a7\u5236\u542f\u7528\u72b6\u6001\u548c\u6392\u5e8f\u3002"}
{"type": "SentenceBoundary", "offset": 109837958, "duration": 70601849, "text": "\u4e0d\u540c\u5c0f\u533a\u5206\u522b\u7ef4\u62a4\u57fa\u7840\u8d44\u6599\uff0c\u4e0d\u80fd\u628a\u4e00\u4e2a\u5c0f\u533a\u7684\u5355\u4ef7\u76f4\u63a5\u4f5c\u4e3a\u6240\u6709\u5c0f\u533a\u7684\u6536\u8d39\u89c4\u5219\u3002"}
