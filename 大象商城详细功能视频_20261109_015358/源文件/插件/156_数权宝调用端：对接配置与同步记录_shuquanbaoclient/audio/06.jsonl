{"type": "SentenceBoundary", "offset": 1000000, "duration": 86268515, "text": "\u8fd9\u6b21\u6f14\u793a\u5148\u7ef4\u62a4\u4f01\u4e1a\u5bf9\u63a5\u914d\u7f6e\u3001\u6d4b\u8bd5\u8fde\u63a5\uff0c\u518d\u9009\u62e9\u540c\u6b65\u8303\u56f4\uff0c\u6700\u540e\u533a\u5206\u8c03\u7528\u7aef\u961f\u5217\u548c\u672c\u4f53\u8bb0\u5f55\u3002"}
{"type": "SentenceBoundary", "offset": 87268515, "duration": 97800922, "text": "\u5927\u8c61\u5546\u57ce\u6570\u6743\u5b9d\u8c03\u7528\u7aef\uff0c\u628a\u5546\u57ce\u4e1a\u52a1\u4e8b\u4ef6\u7684\u63a5\u5165\u3001\u540c\u6b65\u548c\u67e5\u8be2\u5206\u5c42\u7ec4\u7ec7\uff0c\u8ba9\u4f01\u4e1a\u6309\u5bf9\u5e94\u73af\u8282\u6838\u5bf9\u5904\u7406\u60c5\u51b5\u3002"}
