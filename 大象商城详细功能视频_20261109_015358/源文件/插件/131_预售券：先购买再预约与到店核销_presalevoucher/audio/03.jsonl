{"type": "SentenceBoundary", "offset": 1000000, "duration": 92518514, "text": "\u9884\u7ea6\u65e5\u5386\u628a\u5546\u54c1\u3001\u89c4\u683c\u3001\u95e8\u5e97\u548c\u65e5\u671f\u5bf9\u5e94\u8d77\u6765\uff0c\u7ba1\u7406\u6bcf\u65e5\u5e93\u5b58\u3001\u9501\u5b9a\u5e93\u5b58\u3001\u5df2\u9884\u7ea6\u5e93\u5b58\u53ca\u65e5\u671f\u52a0\u4ef7\u3002"}
{"type": "SentenceBoundary", "offset": 93518514, "duration": 95023144, "text": "\u7528\u6237\u5148\u9009\u62e9\u95e8\u5e97\u548c\u65e5\u671f\uff0c\u518d\u770b\u8fd9\u6b21\u9884\u7ea6\u662f\u5426\u9700\u8981\u8865\u5dee\u4ef7\uff1b\u666e\u901a\u5546\u54c1\u5e93\u5b58\u4e0e\u5177\u4f53\u65e5\u671f\u7684\u9884\u7ea6\u5bb9\u91cf\u4e0d\u662f\u540c\u4e00\u4e2a\u53e3\u5f84\u3002"}
