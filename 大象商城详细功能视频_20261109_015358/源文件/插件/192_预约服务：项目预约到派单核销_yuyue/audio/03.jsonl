{"type": "SentenceBoundary", "offset": 1000000, "duration": 76199071, "text": "\u7ba1\u7406\u65b9\u914d\u7f6e\u53ef\u9884\u7ea6\u7684\u661f\u671f\u548c\u65f6\u95f4\u70b9\uff0c\u6309\u9700\u8981\u6253\u5f00\u65e5\u5386\u529f\u80fd\uff0c\u7ba1\u7406\u670d\u52a1\u4eba\u5458\u6392\u73ed\u4e0e\u9884\u7ea6\u65f6\u95f4\u3002"}
{"type": "SentenceBoundary", "offset": 77199071, "duration": 117361106, "text": "\u9879\u76ee\u65f6\u95f4\u3001\u4eba\u5458\u5b89\u6392\u548c\u8ba2\u5355\u6d41\u7a0b\u6a21\u5f0f\u662f\u4e0d\u540c\u8bbe\u7f6e\uff0c\u4e0d\u80fd\u53ea\u6539\u4e00\u4e2a\u65f6\u95f4\u70b9\u5c31\u8ba4\u5b9a\u4eba\u5458\u5df2\u7ecf\u6392\u597d\u73ed\uff0c\u4e5f\u4e0d\u7f16\u9020\u81ea\u52a8\u907f\u5f00\u6240\u6709\u65f6\u95f4\u51b2\u7a81\u7684\u80fd\u529b\u3002"}
