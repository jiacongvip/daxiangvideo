{"type": "SentenceBoundary", "offset": 1000000, "duration": 135111105, "text": "\u8fd9\u6b21\u6f14\u793a\u4ece\u670d\u52a1\u5206\u7c7b\u3001\u4eba\u5458\u4e0e\u5546\u54c1\u5f00\u59cb\uff0c\u8bbe\u7f6e\u9884\u7ea6\u65f6\u95f4\u548c\u6d41\u7a0b\u6a21\u5f0f\uff0c\u4e32\u8d77\u7528\u6237\u9884\u7ea6\u4ed8\u6b3e\u3001\u4eba\u5458\u5206\u914d\u3001\u6838\u9500\u4e0e\u8ba2\u5355\u56de\u67e5\uff0c\u518d\u8865\u5145\u5957\u9910\u3001\u8bc4\u4ef7\u548c\u63d0\u6210\u7ba1\u7406\u3002"}
{"type": "SentenceBoundary", "offset": 136111105, "duration": 72337960, "text": "\u5927\u8c61\u5546\u57ce\u9884\u7ea6\u670d\u52a1\uff0c\u8ba9\u9879\u76ee\u914d\u7f6e\u4e0e\u5b9e\u9645\u670d\u52a1\u5904\u7406\u5404\u6709\u5165\u53e3\uff0c\u4fbf\u4e8e\u56f4\u7ed5\u540c\u4e00\u9884\u7ea6\u534f\u4f5c\u3002"}
