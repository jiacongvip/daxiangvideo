{"type": "SentenceBoundary", "offset": 1000000, "duration": 78976848, "text": "\u9700\u8981\u7ec4\u5408\u670d\u52a1\u65f6\uff0c\u53ef\u4ee5\u7ef4\u62a4\u5957\u9910\u57fa\u672c\u4fe1\u606f\uff0c\u628a\u591a\u4e2a\u670d\u52a1\u5546\u54c1\u7ec4\u6210\u5957\u9910\uff0c\u5e76\u7ba1\u7406\u5957\u9910\u4f7f\u7528\u6b21\u6570\u3002"}
{"type": "SentenceBoundary", "offset": 79976848, "duration": 128935180, "text": "\u5355\u9879\u670d\u52a1\u8ba2\u5355\u4e0e\u5957\u9910\u4f7f\u7528\u7ba1\u7406\u662f\u4e0d\u540c\u5c42\u7ea7\uff0c\u8fd0\u8425\u5148\u786e\u8ba4\u7528\u6237\u8d2d\u4e70\u7684\u662f\u5355\u9879\u9879\u76ee\u8fd8\u662f\u5957\u9910\uff0c\u518d\u5904\u7406\u540e\u7eed\u670d\u52a1\uff0c\u4e0d\u7f16\u9020\u6709\u6548\u671f\u3001\u8f6c\u8d60\u6216\u8de8\u5e97\u901a\u7528\u89c4\u5219\u3002"}
