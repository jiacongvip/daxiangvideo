{"type": "SentenceBoundary", "offset": 1000000, "duration": 89046292, "text": "\u8d22\u52a1\u4ece\u540e\u53f0\u8ddf\u8e2a\u5904\u7406\u4e2d\u8bb0\u5f55\uff0c\u4f1a\u5458\u4ece\u81ea\u5df1\u7684\u63d0\u73b0\u8bb0\u5f55\u786e\u8ba4\u6536\u6b3e\uff0c\u53cc\u65b9\u6838\u5bf9\u7684\u662f\u540c\u4e00\u7b14\u63d0\u73b0\u7684\u72b6\u6001\u63a8\u8fdb\u3002"}
{"type": "SentenceBoundary", "offset": 90046292, "duration": 92476848, "text": "\u9700\u8981\u786e\u8ba4\u65f6\u5904\u7406\u786e\u8ba4\uff0c\u5931\u8d25\u65f6\u67e5\u770b\u8fd4\u56de\u7ed3\u679c\uff0c\u4e0d\u628a\u5904\u7406\u4e2d\u72b6\u6001\u9690\u85cf\u8d77\u6765\uff0c\u4e5f\u4e0d\u628a\u7533\u8bf7\u65f6\u95f4\u5f53\u4f5c\u5230\u8d26\u65f6\u95f4\u3002"}
