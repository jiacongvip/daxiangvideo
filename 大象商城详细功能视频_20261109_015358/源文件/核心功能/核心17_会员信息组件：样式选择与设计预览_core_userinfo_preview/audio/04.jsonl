{"type": "SentenceBoundary", "offset": 1000000, "duration": 95180551, "text": "\u9009\u5b9a\u6837\u5f0f\u540e\uff0c\u7528\u540c\u4e00\u914d\u7f6e\u67e5\u770b\u8bbe\u8ba1\u5668\u9884\u89c8\u548c\u624b\u673a\u7aef\u9875\u9762\uff0c\u91cd\u70b9\u6838\u5bf9\u5934\u50cf\u6392\u7248\u3001\u5361\u7247\u88c5\u9970\u4e0e\u63a8\u8350\u4eba\u5934\u50cf\u3002"}
{"type": "SentenceBoundary", "offset": 96180551, "duration": 86226848, "text": "\u9884\u89c8\u7528\u4e8e\u63d0\u524d\u4e86\u89e3\u5e03\u5c40\uff0c\u5177\u4f53\u56fe\u7247\u548c\u8d44\u6599\u4ecd\u7531\u5f53\u524d\u914d\u7f6e\u51b3\u5b9a\uff0c\u4e0d\u7528\u6f14\u793a\u4f1a\u5458\u8d44\u6599\u5192\u5145\u771f\u5b9e\u5ba2\u6237\u6570\u636e\u3002"}
