{"type": "SentenceBoundary", "offset": 1000000, "duration": 60611108, "text": "\u6807\u9898\u53ef\u4ee5\u8bbe\u7f6e\u5b57\u53f7\u3001\u989c\u8272\u4e0e\u5bf9\u9f50\uff1b\u6587\u672c\u652f\u6301\u591a\u884c\u3001\u884c\u9ad8\u4e0e\u5bf9\u9f50\u3002"}
{"type": "SentenceBoundary", "offset": 61111108, "duration": 96643514, "text": "\u56fe\u7247\u652f\u6301\u5355\u56fe\u3001\u591a\u56fe\u4ee5\u53ca\u94fe\u63a5\uff0c\u6309\u94ae\u53ef\u4ee5\u7ef4\u62a4\u6587\u5b57\u3001\u989c\u8272\u3001\u5706\u89d2\u548c\u76ee\u6807\u94fe\u63a5\uff0c\u5bcc\u6587\u672c\u7528\u4e8e\u66f4\u4e30\u5bcc\u7684\u8bf4\u660e\u3002"}
{"type": "SentenceBoundary", "offset": 157754623, "duration": 76967589, "text": "\u8fd0\u8425\u6309\u5185\u5bb9\u9009\u62e9\u7ec4\u4ef6\uff0c\u5206\u522b\u7ef4\u62a4\u56fe\u7247\u3001\u6587\u5b57\u4e0e\u6309\u94ae\uff0c\u800c\u4e0d\u662f\u628a\u6574\u9875\u90fd\u585e\u8fdb\u4e00\u5f20\u56fe\u7247\u3002"}
