{"type": "SentenceBoundary", "offset": 1000000, "duration": 103050921, "text": "\u8fd9\u6b21\u6848\u4f8b\u4e32\u8d77\u6587\u7ae0\u6253\u5f00\u8ba1\u65f6\u3001\u9690\u85cf\u6216\u5173\u95ed\u4fdd\u5b58\uff0c\u518d\u5230\u56e2\u957f\u540e\u53f0\u67e5\u770b\u8bbf\u95ee\u91cf\u3001\u7528\u6237\u6570\u3001\u5e73\u5747\u65f6\u957f\u4e0e\u8be6\u7ec6\u8bb0\u5f55\u3002"}
{"type": "SentenceBoundary", "offset": 104050921, "duration": 88425922, "text": "\u5927\u8c61\u5546\u57ce\u56e2\u957f\u6587\u7ae0\u8db3\u8ff9\uff0c\u628a\u5185\u5bb9\u3001\u8bbf\u95ee\u8fc7\u7a0b\u548c\u8fd0\u8425\u56de\u67e5\u8054\u7cfb\u8d77\u6765\uff0c\u5e2e\u52a9\u8fd0\u8425\u7406\u89e3\u8fd9\u7bc7\u6587\u7ae0\u7684\u8bbf\u95ee\u60c5\u51b5\u3002"}
