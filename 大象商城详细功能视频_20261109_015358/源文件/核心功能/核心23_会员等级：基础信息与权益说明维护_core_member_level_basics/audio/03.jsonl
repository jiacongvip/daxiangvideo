{"type": "SentenceBoundary", "offset": 1000000, "duration": 78550922, "text": "\u6743\u76ca\u8bbe\u7f6e\u63d0\u4f9b\u7b49\u7ea7\u6709\u6548\u671f\uff0c\u540c\u65f6\u53ef\u4ee5\u7f16\u8f91\u7b49\u7ea7\u8bf4\u660e\u4e0e\u6743\u76ca\u63cf\u8ff0\uff0c\u8bf4\u660e\u5185\u5bb9\u652f\u6301\u5bcc\u6587\u672c\u3002"}
{"type": "SentenceBoundary", "offset": 79050922, "duration": 55902775, "text": "\u6709\u6548\u671f\u8bb0\u5f55\u7b49\u7ea7\u7684\u65f6\u95f4\u8bbe\u7f6e\uff0c\u6587\u5b57\u8bf4\u660e\u5411\u4f1a\u5458\u89e3\u91ca\u6743\u76ca\u5185\u5bb9\u3002"}
