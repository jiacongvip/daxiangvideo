{"type": "SentenceBoundary", "offset": 1000000, "duration": 122842587, "text": "\u8fd9\u6b21\u552e\u540e\u6848\u4f8b\u5148\u786e\u8ba4\u8ba2\u5355\u72b6\u6001\u548c\u53ef\u9000\u8303\u56f4\uff0c\u518d\u9009\u62e9\u5546\u54c1\u6570\u91cf\u3001\u586b\u5199\u539f\u56e0\uff0c\u533a\u5206\u540e\u53f0\u9000\u6b3e\u4e0e\u7528\u6237\u5f85\u5ba1\u6838\u7533\u8bf7\uff0c\u6700\u540e\u901a\u8fc7\u72b6\u6001\u548c\u8bb0\u5f55\u56de\u67e5\u3002"}
{"type": "SentenceBoundary", "offset": 123842587, "duration": 94560181, "text": "\u5927\u8c61\u5546\u57ce\u666e\u901a\u5546\u54c1\u9000\u6b3e\uff0c\u628a\u7533\u8bf7\u4fe1\u606f\u3001\u5ba1\u6838\u51b3\u5b9a\u4e0e\u4e1a\u52a1\u8bb0\u5f55\u5206\u5c42\u7ec4\u7ec7\uff0c\u65b9\u4fbf\u552e\u540e\u4eba\u5458\u6309\u5177\u4f53\u8ba2\u5355\u5904\u7406\u3002"}
