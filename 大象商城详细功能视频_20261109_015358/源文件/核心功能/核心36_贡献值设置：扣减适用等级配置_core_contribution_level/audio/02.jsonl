{"type": "SentenceBoundary", "offset": 1000000, "duration": 106870366, "text": "\u5168\u90e8\u52fe\u9009\u65f6\uff0c\u6240\u6709\u7b49\u7ea7\u53d7\u8fd9\u9879\u8d21\u732e\u503c\u9650\u5236\uff1b\u90e8\u5206\u52fe\u9009\u65f6\uff0c\u53ea\u5bf9\u52fe\u9009\u7b49\u7ea7\u751f\u6548\uff1b\u5168\u90e8\u4e0d\u52fe\u9009\uff0c\u7b49\u540c\u5173\u95ed\u8fd9\u9879\u8d21\u732e\u503c\u6263\u51cf\u3002"}
{"type": "SentenceBoundary", "offset": 107870366, "duration": 101736107, "text": "\u7ef4\u62a4\u4eba\u5458\u4fdd\u5b58\u524d\u5e94\u9010\u9879\u786e\u8ba4\uff0c\u4e0d\u628a\u5168\u4e0d\u9009\u8bef\u89e3\u4e3a\u6cbf\u7528\u4e4b\u524d\u52fe\u9009\u7684\u7b49\u7ea7\uff0c\u4e5f\u4e0d\u628a\u4e00\u9879\u6263\u51cf\u5173\u95ed\u5f53\u6210\u5173\u95ed\u5168\u90e8\u8d21\u732e\u503c\u529f\u80fd\u3002"}
