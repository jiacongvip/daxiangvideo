{"type": "SentenceBoundary", "offset": 1000000, "duration": 105712958, "text": "\u5c0f\u7a0b\u5e8f\u8ba2\u9605\u6d88\u606f\u8981\u6c42\u7528\u6237\u5df2\u8ba2\u9605\u5bf9\u5e94\u6a21\u677f\uff0c\u516c\u4f17\u53f7\u6a21\u677f\u6d88\u606f\u8981\u6c42\u5173\u6ce8\u516c\u4f17\u53f7\uff0c\u77ed\u4fe1\u8981\u6c42\u7528\u6237\u6709\u624b\u673a\u53f7\u4e14\u77ed\u4fe1\u529f\u80fd\u5df2\u5f00\u542f\u3002"}
{"type": "SentenceBoundary", "offset": 106712958, "duration": 79745367, "text": "\u76f8\u5173\u6a21\u677f\u548c\u6e20\u9053\u8981\u5148\u914d\u7f6e\u597d\uff0c\u4e0d\u80fd\u53ea\u770b\u70b9\u51fb\u4e86\u63a8\u9001\u6309\u94ae\uff0c\u5c31\u9ed8\u8ba4\u6bcf\u4e2a\u7528\u6237\u90fd\u80fd\u6536\u5230\u5168\u90e8\u6e20\u9053\u3002"}
